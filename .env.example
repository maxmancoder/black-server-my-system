# Neon storage configuration. Copy to .env and fill in real values.
# Never commit .env — it is ignored by .gitignore.

# Object Storage (S3-compatible, path-style addressing is forced in code)
AWS_ENDPOINT_URL_S3=https://<account>.storage.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
# The name of the bucket you created in the Neon console - not the account id
BUCKET_NAME=<bucket>

# Postgres metadata (file names, sizes, dates, permissions)
# Connection string from the Neon console, Connection tab
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Backend selection: auto (default) | neon | local
#   auto - use Neon when fully configured, local disk when nothing is set,
#          error when the configuration is only partial
#   neon - require a complete configuration, never fall back to disk
#   local - always use the local disk store (development / test only)
# Use "neon" once the values above are filled in: the site then keeps every
# upload, edit, file and folder in Neon and never writes to the local disk.
#BS_STORAGE=auto

# After the first switch, move the files that are already in ./downloads:
#   python server.py --check-storage      # test the bucket and the database
#   python server.py --migrate-dry-run    # show what would be copied
#   python server.py --migrate            # copy them into Neon

# Optional
#BS_PRESIGN_TTL=3600
#BS_USER=anonymous
